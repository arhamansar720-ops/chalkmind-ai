# Copy to .env.local and fill in. Everything here is read on the server only,
# except variables prefixed NEXT_PUBLIC_ (safe-to-publish Supabase URL/anon key).

# ── AI provider (required for the tutor, homework solver and study generator) ──
# One of: groq | openai | anthropic | openrouter | ollama | openai-compatible
# If unset, Chalkmind auto-detects from GROQ_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY.
AI_PROVIDER=groq
# API key for the provider (or set the provider-specific variable, e.g. GROQ_API_KEY).
AI_API_KEY=
# Model id. Defaults: groq → openai/gpt-oss-120b, openai → gpt-5-mini,
# anthropic → claude-haiku-5-5, openrouter → openai/gpt-oss-120b, ollama → qwen3.
AI_MODEL=
# Model used when a student attaches an image. Default: groq → qwen/qwen3.8-27b,
# openai/anthropic → same as AI_MODEL. Set to "none" to disable image input.
AI_VISION_MODEL=
# Override the API base URL (required for openai-compatible; optional for ollama).
AI_BASE_URL=
# Upper bound on output tokens per request (default 4096).
AI_MAX_OUTPUT_TOKENS=

# ── Local, free option: Ollama ──
# AI_PROVIDER=ollama
# AI_MODEL=qwen3            # any model you've pulled: `ollama pull qwen3`
# AI_VISION_MODEL=gemma3    # optional, a vision-capable local model

# ── Optional: embeddings for semantic document search ──
# Without this, document Q&A uses keyword (BM25) search.
# EMBEDDINGS_PROVIDER=ollama          # or: openai
# EMBEDDINGS_MODEL=nomic-embed-text   # openai default: text-embedding-3-small
# EMBEDDINGS_API_KEY=                 # openai only (falls back to OPENAI_API_KEY)
# EMBEDDINGS_BASE_URL=

# ── Limits ──
# AI requests per minute per client (per server instance). Default 20.
RATE_LIMIT_PER_MINUTE=20

# ── Optional: cloud sync + sign-in with Supabase ──
# Without these, all data is stored in the browser (IndexedDB) on this device.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Require a signed-in Supabase user for all AI routes (recommended for public deployments).
# REQUIRE_AUTH=true

# ── Development only ──
# Logs invalid structured AI replies to the server console (may include student input). Never enable in production.
# CHALKMIND_DEBUG_AI=1
